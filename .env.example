# Copy to .env (git-ignored) and fill in. Values here are placeholders, not real secrets.
# The drive's own secrets (OAuth, password hash) live in pocket-drive/backend/.env, not here.

# Where private dashboards (Uptime Kuma, Netdata) listen. Use the machine's Tailscale address so they
# are reachable from your tailnet and nowhere else; 127.0.0.1 restricts them to this machine only.
BIND_ADDR=100.x.y.z

# Public hostnames served by nginx
DOMAIN_ROOT=example.com
DOMAIN_DRIVE=drive.example.com

# Where the app keeps its data on the host
STORAGE_DIR=/srv/pocket/files          # uploaded files (local SSD)
DATA_DIR=/srv/pocket/data              # SQLite DB, thumbnails, video streams (local disk, never a network mount)
PORTFOLIO_DIST=/path/to/portfolio/dist # built static site

# The phone: migration source (Phase 4) and backup target (Phase 8), reached over Tailscale + SSH
PHONE_HOST=100.x.y.z
PHONE_PORT=22
PHONE_USER=root
PHONE_KEY=/home/you/.ssh/phone_key
REMOTE_DATA=/root/cloud-storage      # the phone's DATA_DIR
REMOTE_REPO=/root/cloud-drive        # the phone's checkout, for its better-sqlite3

# Backup job (Phase 8)
REMOTE_BACKUP=/root/backup             # where on the phone backups land
RETAIN_SNAPSHOTS=14                    # database snapshots + manifests to keep
RETAIN_DELETED_DAYS=30                 # how long deleted files stay recoverable
BACKUP_MIN_FREE_GB=10                  # refuse to run if the phone has less room than this
# Uptime Kuma "Push" monitor URL. The backup pings it on success; Kuma alerts when a ping
# does not arrive, which catches a backup that stopped running at all.
BACKUP_PUSH_URL=

# Added in later phases
TUNNEL_NAME=home-server
# CLOUDFLARE_TUNNEL_TOKEN=
